# 1. 루트 폴더 사용자 정의(Please change "your_real_root_folder_name" to the name of your actual root folder)
ROOT_FOLDER="Proj"
USER_NAME="$USERNAME"

#rn rma.bat 변수
AVD_NAME="pixel_30"
JAVA_HOME="C:\Program Files\Java\jdk-17"
ANDROID_HOME="C:\Users\$USERNAME\Android"
ANDROID_PLATFORM_PATH="C:\Users\$USERNAME\Android\platform-tools"

#Notion 사용 여부
NOTION_USE=YES

# 2. OS 감지
if grep -qi microsoft /proc/version; then
  DETECTED_OS="windows"
else
  case "$(uname -s)" in
    Darwin*) DETECTED_OS="macos" ;;
    Linux*)  DETECTED_OS="linux" ;;
    *)       DETECTED_OS="unknown" ;;
  esac
fi

# 3. (vscode)base_path 자동 설정
case "$DETECTED_OS" in
  windows)
    BASE_PATH="/mnt/c/Users/${USER_NAME}/Desktop/$ROOT_FOLDER"
    VSCODE_PATH="C:\\Users\\${USER_NAME}\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe"
    ;;
  macos)
    BASE_PATH="$HOME/Desktop/$ROOT_FOLDER"
    VSCODE_PATH="/Applications/Visual Studio Code.app/Contents/MacOS/Electron"
    ;;
  linux)
    BASE_PATH="$HOME/Desktop/$ROOT_FOLDER"
    if [ -f /etc/os-release ]; then
       . /etc/os-release   # 변수들을 환경에 로드함

       echo "Detected OS: $NAME"

       if [[ "$ID" == "ubuntu" ]]; then
           echo "Ubuntu"
           VSCODE_PATH="/snap/bin/code"
       # Ubuntu 전용 명령 실행
       elif [[ "$ID" == "debian" ]]; then
           echo "Debian"
           VSCODE_PATH="/usr/share/code/code ."
        # Debian 전용 명령 실행
       else
           echo "다른 리눅스 배포판: $ID"
           echo "VSCODE_PATH를 수동으로 설정해주세요"
       fi
    else
    echo "지원되는 LINUX가 아닙니다."
  fi
    ;;
  *)
    echo "❌ 알 수 없는 OS입니다: $DETECTED_OS"
    exit 1
    ;;
esac

# (notion)base_path 설정(선택적)
if [[ "$NOTION_USE" == "YES" ]]; then
  if [[ "$DETECTED_OS" == "windows" ]]; then
    NOTION_PATH="C:\\Users\\${USER_NAME}\\AppData\\Local\\Programs\\Notion\\Notion.exe"
  elif [[ "$DETECTED_OS" == "macos" ]]; then
    NOTION_PATH="/Applications/Notion.app/Contents/MacOS/Notion"
  elif [[ "$DETECTED_OS" == "linux" ]]; then
    NOTION_PATH="/usr/bin/notion"
  fi
fi


echo "📁 BASE_PATH = $BASE_PATH"
# base_path 폴더가 없을 때만 생성
if [ ! -d "$BASE_PATH" ]; then
  mkdir -p "$BASE_PATH"
  echo "[Info] $BASE_PATH 폴더를 새로 생성했습니다."
else
  echo "[Info] $BASE_PATH 폴더는 이미 존재합니다. : $BASE_PATH"
fi

# base_path를 파일에 저장

{
echo "BASE_PATH=$BASE_PATH"
echo "VSCODE_PATH=$VSCODE_PATH"
echo "ROOT_FOLDER=$ROOT_FOLDER"
echo "JAVA_HOME=$JAVA_HOME"
echo "ANDROID_HOME=$ANDROID_HOME"
echo "AVD_NAME=$AVD_NAME"
echo "ANDROID_PLATFORM_PATH=$ANDROID_PLATFORM_PATH"
if [[ -n "$NOTION_PATH" ]]; then
  echo "NOTION_PATH=$NOTION_PATH"
fi
} > ~/scripts/path_collection.txt
